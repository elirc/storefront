# Storefront — example environment. Copy to `.env` (gitignored). All values here are
# mock/test-mode ONLY; the course build never needs a real credential (see ADR-0000).

# --- Database (Postgres 16; docker-compose service `db`) ---
DATABASE_URL="postgresql://storefront:storefront@localhost:5432/storefront"

# --- Payments (S05). The fake gateway signs its webhooks with this CONSTANT test secret,
#     and the app verifies against the same one — so the real signature-verification code
#     path runs with zero real Stripe keys. ---
PAYMENTS_DRIVER="fake"
STRIPE_SECRET_KEY="sk_test_ci_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_ci_constant_for_tests"

# --- Object storage (S10). `fs` writes to ./.storage locally; `s3` points at MinIO. ---
OBJECT_STORE_DRIVER="fs"
# OBJECT_STORE_ENDPOINT="http://localhost:9000"
# OBJECT_STORE_ACCESS_KEY="storefront"
# OBJECT_STORE_SECRET_KEY="storefront"
# OBJECT_STORE_BUCKET="storefront-images"
